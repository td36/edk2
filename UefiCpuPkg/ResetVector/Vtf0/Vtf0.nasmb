;
; If none of ARCH_IA32, ARCH_X64 and ARCH_P64 is defined, then try to include
; Base.h to use the C pre-processor to determine the architecture.
;
%ifndef ARCH_IA32
  %ifndef ARCH_X64
    %ifndef ARCH_P64
      #include <Base.h>
      #if defined (MDE_CPU_IA32)
        %define ARCH_IA32
      #elif defined (MDE_CPU_X64)
        %define ARCH_X64
      #endif
    %endif
  %endif
%endif

%ifdef ARCH_IA32
  %ifdef ARCH_X64
    %error "Only one of ARCH_IA32, ARCH_X64 or ARCH_P64 can be defined."
  %elifdef ARCH_P64
    %error "Only one of ARCH_IA32, ARCH_X64 or ARCH_P64 can be defined."
  %endif
%elifdef ARCH_X64
  %ifdef ARCH_P64
    %error "Only one of ARCH_IA32, ARCH_X64 or ARCH_P64 can be defined."
  %endif
%elifdef ARCH_P64

%else
  %error "One of ARCH_IA32, ARCH_X64 or ARCH_P64 must be defined."
%endif

%include "CommonMacros.inc"

%include "PostCodes.inc"

%include "PageTables.inc"

%ifdef ARCH_X64
  %ifdef PAGE_TABLE_1G
    %include "X64/PageTables1G.asm"
  %else
    %include "X64/PageTables2M.asm"
  %endif
%elifdef ARCH_P64
  %include "X64/PageTables1G.asm"
  %include "P64/InitialPageTables.asm"
%endif

%ifdef DEBUG_PORT80
  %include "Port80Debug.asm"
%elifdef DEBUG_SERIAL
  %include "SerialDebug.asm"
%else
  %include "DebugDisabled.asm"
%endif

%ifdef ARCH_P64
BITS 64
%else
BITS 32
%endif
%include "SearchForBfvBase.asm"
%include "SearchForSecEntry.asm"

%ifdef ARCH_X64
  %include "Ia32/Flat32ToFlat64.asm"
  %include "Ia32/PageTables64.asm"
%elifdef ARCH_P64
  %include "P64/PageTables64.asm"
%endif

%ifdef ARCH_P64
  %include "P64/Init64.asm"
  %include "P64/Main.asm"
  %include "P64/ResetVectorVtf0.asm"
%else
  %include "Ia16/Real16ToFlat32.asm"
  %include "Ia16/Init16.asm"
  %include "Main.asm"
  %include "Ia16/ResetVectorVtf0.asm"
%endif
